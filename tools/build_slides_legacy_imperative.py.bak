# --- 8. Cắt cửa sổ & Tăng cường dữ liệu ---
s = slide(); title(s, "Cắt cửa sổ (Windowing) & Tăng cường dữ liệu")
image(s, "har_windows.png", 1.0, 1.4, 8.0, 3.2)
bullets(s, [
