s = slide(); title(s, "Phân tích phân bố vận tốc góc → chọn thang ±500 dps")
image(s, "gyro_distribution_2x2.png", 1.3, 1.4, 7.4, 4.3)
bullets(s, [
    "P99,9 ≈ 463 dps → chọn thang ±500 dps: tối ưu độ phân giải INT8 (so với ±2000 dps).",
