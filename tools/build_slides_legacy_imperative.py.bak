# --- PL0. Phụ lục — Bộ dữ liệu SisFall (thầy hay hỏi) ---
s = slide(); title(s, "Phụ lục — Bộ dữ liệu SisFall")
table(s, [
    ["Thuộc tính", "Giá trị"],
    ["Nguồn", "Công khai — Sucerquia et al., Univ. Antioquia (2017)"],
    ["Đối tượng", "38 người: 23 trẻ SA (19–30 tuổi) + 15 già SE (60–75 tuổi)"],
    ["Hoạt động ADL", "19 loại (D01–D19): đi, chạy, cầu thang, ngồi/đứng, nằm, cúi…"],
    ["Té ngã", "15 kiểu (F01–F15): ngã trước/sau/ngang, khi ngồi, ngất xỉu…"],
    ["Số file", "4.510 file (mỗi file 1 hoạt động)"],
    ["Cảm biến (9 cột)", "2 gia tốc kế ADXL345 (±16g) + MMA8451Q (±8g); 1 con quay ITG3200 (±2000°/s)"],
    ["Tần số", "200 Hz gốc → đồ án hạ 100 Hz, dùng 6 kênh (accel + gyro)"],
], left=0.5, top=1.5, width=9.0, height=3.7, fs=12)
bullets(s, [
    "⚠ Điểm thầy hay hỏi — thiên lệch dữ liệu: người già GẦN NHƯ chỉ mô phỏng ADL; chỉ DUY NHẤT SE06 "
    "(chuyên Judo) thực hiện ngã → toàn bộ dữ liệu NGÃ gần như của người trẻ.",
    "→ Hạn chế khái quát hoá cho người già (KFold: S1 thiếu mẫu Fall-SE; S4 Precision 74,6%). Đồ án bù bằng "
    "split subject-independent + kế hoạch thu dữ liệu cá nhân trên thiết bị thật.",
], top=5.35, size=12)

